<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- ================================================= -->
    <!-- S01 FitLog 메인 화면 -->
    <!-- ================================================= -->

    <!-- 전체 메인 콘텐츠 스크롤 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- ========================================= -->
            <!-- 1. 상단 FitLog 로고 -->
            <!-- ========================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="FitLog"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:textColor="#168564"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="오늘도 건강한 하루를 시작해요!"
                        android:textSize="12sp"
                        android:textColor="#888888"/>

                </LinearLayout>

                <!-- 알림 아이콘 -->
                <!-- 알림 아이콘 -->
                <ImageView
                    android:id="@+id/btnNotification"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:padding="8dp"
                    android:src="@drawable/fitlog_notice"
                    android:scaleType="fitCenter"
                    android:contentDescription="알림"
                    android:clickable="true"
                    android:focusable="true" />

                <!-- 프로필 아이콘 -->
                <TextView
                    android:id="@+id/btnProfile"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:text="●"
                    android:contentDescription="프로필"
                    android:textSize="28sp"
                    android:textColor="#168564"/>

            </LinearLayout>


            <!-- ========================================= -->
            <!-- 2. 오늘의 운동 배너 -->
            <!-- ========================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginTop="20dp"
                android:padding="20dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#DDF3E9">

                <!-- 왼쪽 날짜 및 문구 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvTodayDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2026년 11월 2일 (월)"
                        android:textSize="14sp"
                        android:textColor="#555555"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="오늘도 운동할까요?"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#111111"/>

                </LinearLayout>

                <!-- 오른쪽 덤벨 이미지 -->
                <ImageView
                    android:id="@+id/imgWorkoutBanner"
                    android:layout_width="85dp"
                    android:layout_height="85dp"
                    android:layout_marginStart="8dp"
                    android:src="@drawable/figlog_main_workicon"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"
                    android:visibility="visible"
                    android:contentDescription="운동 덤벨 아이콘" />

            </LinearLayout>


            <!-- ========================================= -->
            <!-- 3. 오늘의 운동 일정 -->
            <!-- ========================================= -->

            <!-- 3. 오늘의 운동 일정 제목 + 달력 아이콘 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- 왼쪽 달력 아이콘 -->
                <ImageView
                    android:id="@+id/imgScheduleIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/figlog_main_schedule"
                    android:scaleType="fitCenter"
                    android:contentDescription="운동 일정 달력 아이콘"/>

                <!-- 오늘의 운동 일정 제목 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="오늘의 운동 일정"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:textColor="#222222"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="가슴 운동 루틴"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#222222"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="18:00 - 19:30"
                        android:textSize="13sp"
                        android:textColor="#999999"/>

                </LinearLayout>

                <Button
                    android:id="@+id/btnStartWorkout"
                    android:layout_width="110dp"
                    android:layout_height="48dp"
                    android:text="운동하기"
                    android:textSize="14sp"
                    android:textColor="#FFFFFF"
                    android:textAllCaps="false"
                    android:backgroundTint="#168564"/>

            </LinearLayout>


            <!-- 구분선 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="25dp"
                android:background="#EEEEEE"/>


            <!-- ========================================= -->
            <!-- 4. 최근 운동 기록 -->
            <!-- ========================================= -->

            <!-- 4. 최근 운동 기록 제목 + 시계 아이콘 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- 왼쪽 시계 이미지 -->
                <ImageView
                    android:id="@+id/imgRecentWorkoutIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/figlog_main_timeicon"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"
                    android:contentDescription="최근 운동 기록 시계 아이콘" />

                <!-- 최근 운동 기록 제목 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="최근 운동 기록"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:textColor="#222222" />

            </LinearLayout>


            <!-- 벤치프레스 기록 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="벤치프레스"
                        android:textStyle="bold"
                        android:textSize="15sp"
                        android:textColor="#222222"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2026.09.26 (토)"
                        android:textSize="12sp"
                        android:textColor="#999999"/>

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="3세트\n60kg × 10회"
                    android:textSize="13sp"
                    android:textColor="#888888"/>

            </LinearLayout>


            <!-- 스쿼트 기록 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="스쿼트"
                        android:textStyle="bold"
                        android:textSize="15sp"
                        android:textColor="#222222"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2026.09.24 (목)"
                        android:textSize="12sp"
                        android:textColor="#999999"/>

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="4세트\n100kg × 8회"
                    android:textSize="13sp"
                    android:textColor="#888888"/>

            </LinearLayout>


            <!-- 구분선 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="25dp"
                android:background="#EEEEEE"/>


            <!-- ========================================= -->
            <!-- 5. 내 운동 루틴 -->
            <!-- ========================================= -->

            <!-- 5. 내 운동 루틴 제목 + 덤벨 아이콘 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- 왼쪽 덤벨 이미지 -->
                <ImageView
                    android:id="@+id/imgMyRoutineIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/figlog_main_dumbell"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"
                    android:contentDescription="내 운동 루틴 덤벨 아이콘" />

                <!-- 내 운동 루틴 제목 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="내 운동 루틴"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:textColor="#222222" />

            </LinearLayout>


            <!-- 가슴 운동 루틴 -->
            <LinearLayout
                android:id="@+id/layoutChestRoutine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:padding="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="가슴 운동 루틴"
                        android:textStyle="bold"
                        android:textSize="15sp"
                        android:textColor="#222222"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="운동 4개"
                        android:textSize="12sp"
                        android:textColor="#999999"/>

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textSize="25sp"/>

            </LinearLayout>


            <!-- 하체 운동 루틴 -->
            <LinearLayout
                android:id="@+id/layoutLegRoutine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:padding="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="하체 운동 루틴"
                        android:textStyle="bold"
                        android:textSize="15sp"
                        android:textColor="#222222"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="운동 5개"
                        android:textSize="12sp"
                        android:textColor="#999999"/>

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textSize="25sp"/>

            </LinearLayout>


            <!-- ========================================= -->
            <!-- 6. 새로운 루틴 만들기 -->
            <!-- ========================================= -->

            <Button
                android:id="@+id/btnCreateRoutine"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="15dp"
                android:text="+  새로운 루틴 만들기"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:backgroundTint="#168564"/>

        </LinearLayout>

    </ScrollView>


    <!-- ================================================= -->
    <!-- 7. 하단 네비게이션 : PNG 이미지 아이콘 적용 -->
    <!-- ================================================= -->

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#EEEEEE"/>

    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <!-- ========================================= -->
        <!-- 홈 아이콘 -->
        <!-- ========================================= -->

        <LinearLayout
            android:id="@+id/nav_home"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/fitlog_home"
                android:contentDescription="홈"
                android:scaleType="fitCenter"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="홈"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#168564"/>

        </LinearLayout>


        <!-- ========================================= -->
        <!-- 운동 루틴 아이콘 -->
        <!-- ========================================= -->

        <LinearLayout
            android:id="@+id/nav_routine"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/fitlog_routin"
                android:contentDescription="운동 루틴"
                android:scaleType="fitCenter"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="루틴"
                android:textSize="12sp"
                android:textColor="#888888"/>

        </LinearLayout>


        <!-- ========================================= -->
        <!-- 운동 기록 아이콘 -->
        <!-- ========================================= -->

        <LinearLayout
            android:id="@+id/nav_record"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/fitlog_record"
                android:contentDescription="운동 기록"
                android:scaleType="fitCenter"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="기록"
                android:textSize="12sp"
                android:textColor="#888888"/>

        </LinearLayout>


        <!-- ========================================= -->
        <!-- 운동 일정 아이콘 -->
        <!-- ========================================= -->

        <LinearLayout
            android:id="@+id/nav_schedule"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/fitlog_schedule"
                android:contentDescription="운동 일정"
                android:scaleType="fitCenter"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="일정"
                android:textSize="12sp"
                android:textColor="#888888"/>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>