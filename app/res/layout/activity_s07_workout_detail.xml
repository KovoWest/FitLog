<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fitNextRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8F9FA">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="14dp"
        android:paddingTop="6dp"
        android:paddingBottom="2dp">

        <ImageButton
            android:id="@+id/fitScreenBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/fit_screen_back"
            android:src="@drawable/ic_fit_screen_back" />

        <TextView
            style="@style/FitNextHeading"
            android:text="운동 기록 상세 및 비교"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:textSize="20sp"/>
        <TextView
            style="@style/FitNextPlain"
            android:text="수정"
            android:id="@+id/detailEdit"
            android:layout_width="41dp"
            android:textSize="11sp"/>
        <TextView
            style="@style/FitNextPlain"
            android:text="삭제"
            android:id="@+id/detailDelete"
            android:layout_width="41dp"
            android:textSize="11sp"/>
    </LinearLayout>

    <ScrollView
        android:id="@+id/fitNextScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="0dp"
            android:paddingBottom="12dp"
            android:focusableInTouchMode="true">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:id="@+id/detailContent">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/fit_next_card"
                    android:padding="10dp"
                    android:layout_marginTop="7dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <ImageView
                            android:id="@+id/detailImage"
                            android:layout_width="82dp"
                            android:layout_height="66dp"
                            android:scaleType="centerCrop"
                            android:importantForAccessibility="no"
                            android:background="@drawable/fit_next_thumb"
                            android:clipToOutline="true"/>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_weight="1"
                            android:layout_marginStart="13dp">
                            <TextView
                                style="@style/FitNextTitle"
                                android:id="@+id/detailName"
                                android:textSize="22sp"/>
                            <TextView
                                style="@style/FitNextMuted"
                                android:id="@+id/detailSubtitle"
                                android:layout_marginTop="4dp"/>
                        </LinearLayout>
                    </LinearLayout>
                    <TextView
                        style="@style/FitNextMuted"
                        android:id="@+id/detailDate"
                        android:layout_marginTop="7dp"
                        android:minHeight="24dp"
                        android:gravity="center_vertical"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/fit_next_panel"
                    android:padding="10dp"
                    android:layout_marginTop="7dp">
                    <TextView style="@style/FitNextHeading" android:text="이번 기록"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:id="@+id/detailSets">
</LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/fit_next_panel"
                    android:padding="10dp"
                    android:layout_marginTop="7dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            style="@style/FitNextHeading"
                            android:text="이전 기록과 비교"
                            android:layout_width="0dp"
                            android:layout_weight="1"/>
                        <TextView
                            style="@style/FitNextField"
                            android:text="이전 기록 선택"
                            android:id="@+id/detailPrevious"
                            android:layout_width="wrap_content"
                            android:paddingHorizontal="9dp"/>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:id="@+id/detailComparison">
</LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/fit_next_card"
                    android:padding="10dp"
                    android:layout_marginTop="7dp">
                    <TextView style="@style/FitNextHeading" android:text="기록 비교 그래프"/>
                    <TextView
                        style="@style/FitNextMuted"
                        android:id="@+id/detailLegend"
                        android:text="무게 (kg) · ● 이전 기록    ● 이번 기록"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:id="@+id/detailGraph">
</LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <TextView
                style="@style/FitNextText"
                android:text="선택한 운동 기록을 찾을 수 없습니다."
                android:id="@+id/detailMissing"
                android:visibility="gone"/>
        </LinearLayout>
    </ScrollView>
    <include layout="@layout/fit_next_navigation"/>
</LinearLayout>
