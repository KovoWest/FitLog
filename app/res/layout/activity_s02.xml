<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FAFBFC">

    <!-- ====================================== -->
    <!-- S02 운동 루틴 목록 화면 -->
    <!-- ====================================== -->

    <!-- 상단 제목 및 루틴 추가 버튼 -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="28dp"
        android:paddingBottom="20dp">

        <TextView
            android:id="@+id/tvRoutineTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="운동 루틴"
            android:textSize="27sp"
            android:textStyle="bold"
            android:textColor="#111111"/>

        <ImageView
            android:id="@+id/btnAddRoutine"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:src="@drawable/s02_rootin_plus_icon"
            android:scaleType="fitCenter"
            android:contentDescription="루틴 추가"
            android:clickable="true"
            android:focusable="true"/>

    </LinearLayout>


    <!-- ====================================== -->
    <!-- 운동 부위 필터 -->
    <!-- ====================================== -->

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="18dp">

            <TextView
                android:id="@+id/filterAll"
                android:layout_width="66dp"
                android:layout_height="42dp"
                android:gravity="center"
                android:background="@android:drawable/btn_default"
                android:backgroundTint="#009B72"
                android:text="전체"
                android:textSize="15sp"
                android:textColor="#FFFFFF"/>

            <TextView
                android:id="@+id/filterChest"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="가슴"
                android:textSize="15sp"
                android:textColor="#667085"/>

            <TextView
                android:id="@+id/filterBack"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="등"
                android:textSize="15sp"
                android:textColor="#667085"/>

            <TextView
                android:id="@+id/filterLegs"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="하체"
                android:textSize="15sp"
                android:textColor="#667085"/>

            <TextView
                android:id="@+id/filterShoulders"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="어깨"
                android:textSize="15sp"
                android:textColor="#667085"/>

            <TextView
                android:id="@+id/filterArms"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="팔"
                android:textSize="15sp"
                android:textColor="#667085"/>

        </LinearLayout>

    </HorizontalScrollView>


    <!-- ====================================== -->
    <!-- 운동 루틴 목록 -->
    <!-- ====================================== -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none"
        android:fillViewport="false">

        <LinearLayout
            android:id="@+id/routineListContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="10dp">


            <!-- ====================================== -->
            <!-- 1. 가슴 운동 루틴 -->
            <!-- ====================================== -->

            <LinearLayout
                android:id="@+id/cardChestRoutine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="142dp"
                android:orientation="horizontal"
                android:gravity="top"
                android:padding="12dp"
                android:layout_marginBottom="12dp"
                android:background="#FFFFFF"
                android:elevation="3dp">

                <!-- 가슴 이미지 -->

                <!-- 가슴 운동 루틴 이미지 -->
                <ImageView
                    android:id="@+id/imgChestRoutine"
                    android:layout_width="78dp"
                    android:layout_height="88dp"
                    android:layout_marginTop="6dp"
                    android:src="@drawable/s02_chest_icon"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"
                    android:contentDescription="가슴 운동 루틴 이미지" />

                <!-- 운동 정보 -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="10dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="가슴 운동 루틴"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="#111111"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="운동 4개"
                        android:textSize="13sp"
                        android:textColor="#667085"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="1. 벤치프레스&#10;2. 인클라인 벤치프레스&#10;3. 체스트 프레스&#10;4. 딥스"
                        android:textSize="12sp"
                        android:lineSpacingExtra="3dp"
                        android:textColor="#667085"/>

                </LinearLayout>

                <!-- 운동 시작 / 수정 / 삭제 -->

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="10dp">

                    <ImageView
                        android:id="@+id/btnStartChest"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:src="@drawable/s02_start_icon"
                        android:scaleType="fitCenter"
                        android:contentDescription="가슴 운동 시작"
                        android:clickable="true"
                        android:focusable="true" />

                    <ImageView
                        android:id="@+id/btnEditChest"
                        android:layout_width="30dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="3dp"
                        android:src="@drawable/s02_change_icon"
                        android:scaleType="fitCenter"
                        android:contentDescription="가슴 루틴 수정"
                        android:clickable="true"
                        android:focusable="true" />

                    <ImageView
                        android:id="@+id/btnDeleteChest"
                        android:layout_width="27dp"
                        android:layout_height="36dp"
                        android:padding="0dp"
                        android:src="@drawable/s02_delete"
                        android:scaleType="fitCenter"
                        android:contentDescription="가슴 루틴 삭제"
                        android:clickable="true"
                        android:focusable="true" />

                </LinearLayout>

            </LinearLayout>


            <!-- ====================================== -->
            <!-- 2. 하체 운동 루틴 -->
            <!-- ====================================== -->

            <LinearLayout
                android:id="@+id/cardLegsRoutine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="155dp"
                android:orientation="horizontal"
                android:gravity="top"
                android:padding="12dp"
                android:layout_marginBottom="12dp"
                android:background="#FFFFFF"
                android:elevation="3dp">

                <!-- 하체 운동 루틴 이미지 -->

                <ImageView
                    android:layout_width="78dp"
                    android:layout_height="88dp"
                    android:layout_marginTop="6dp"
                    android:contentDescription="하체 운동 루틴 이미지"
                    android:scaleType="fitCenter"
                    android:src="@drawable/s02_lower_icon" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="10dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="하체 운동 루틴"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="#111111"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="운동 5개"
                        android:textSize="13sp"
                        android:textColor="#667085"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="1. 스쿼트&#10;2. 레그프레스&#10;3. 레그익스텐션&#10;4. 레그컬&#10;5. 카프레이즈"
                        android:textSize="12sp"
                        android:lineSpacingExtra="3dp"
                        android:textColor="#667085"/>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="10dp">

                    <ImageView
                        android:id="@+id/btnStartLegs"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/s02_start_icon"
                        android:scaleType="fitCenter"
                        android:contentDescription="하체 운동 시작"
                        android:clickable="true"
                        android:focusable="true" />

                    <ImageView
                        android:id="@+id/btnEditLegs"
                        android:layout_width="30dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="3dp"
                        android:src="@drawable/s02_change_icon"
                        android:scaleType="fitCenter"
                        android:contentDescription="하체 루틴 수정"
                        android:clickable="true"
                        android:focusable="true" />

                    <ImageView
                        android:id="@+id/btnDeleteLegs"
                        android:layout_width="27dp"
                        android:layout_height="36dp"
                        android:padding="0dp"
                        android:src="@drawable/s02_delete"
                        android:scaleType="fitCenter"
                        android:contentDescription="하체 루틴 삭제"
                        android:clickable="true"
                        android:focusable="true" />

                </LinearLayout>

            </LinearLayout>


            <!-- ====================================== -->
            <!-- 3. 등 운동 루틴 -->
            <!-- ====================================== -->

            <LinearLayout
                android:id="@+id/cardBackRoutine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="142dp"
                android:orientation="horizontal"
                android:gravity="top"
                android:padding="12dp"
                android:layout_marginBottom="12dp"
                android:background="#FFFFFF"
                android:elevation="3dp">

                <!-- 등 운동 루틴 이미지 -->
                <ImageView
                    android:layout_width="78dp"
                    android:layout_height="88dp"
                    android:layout_marginTop="6dp"
                    android:src="@drawable/s02_back_icon"
                    android:scaleType="fitCenter"
                    android:contentDescription="등 운동 루틴 이미지" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="10dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="등 운동 루틴"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="#111111"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="운동 4개"
                        android:textSize="13sp"
                        android:textColor="#667085"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="1. 랫풀다운&#10;2. 바벨로우&#10;3. 시티드로우&#10;4. 풀업"
                        android:textSize="12sp"
                        android:lineSpacingExtra="3dp"
                        android:textColor="#667085"/>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="10dp">

                    <ImageView
                        android:id="@+id/btnStartBack"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/s02_start_icon"
                        android:scaleType="fitCenter"
                        android:contentDescription="등 운동 시작"
                        android:clickable="true"
                        android:focusable="true" />

                    <ImageView
                        android:id="@+id/btnEditBack"
                        android:layout_width="30dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="3dp"
                        android:src="@drawable/s02_change_icon"
                        android:scaleType="fitCenter"
                        android:contentDescription="등 루틴 수정"
                        android:clickable="true"
                        android:focusable="true" />

                    <ImageView
                        android:id="@+id/btnDeleteBack"
                        android:layout_width="27dp"
                        android:layout_height="36dp"
                        android:padding="0dp"
                        android:src="@drawable/s02_delete"
                        android:scaleType="fitCenter"
                        android:contentDescription="등 루틴 삭제"
                        android:clickable="true"
                        android:focusable="true" />

                </LinearLayout>

            </LinearLayout>


            <!-- ====================================== -->
            <!-- 4. 어깨 운동 루틴 -->
            <!-- ====================================== -->

            <LinearLayout
                android:id="@+id/cardShoulderRoutine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="142dp"
                android:orientation="horizontal"
                android:gravity="top"
                android:padding="12dp"
                android:layout_marginBottom="12dp"
                android:background="#FFFFFF"
                android:elevation="3dp">

                <!-- 어깨 운동 루틴 이미지 -->
                <ImageView
                    android:layout_width="78dp"
                    android:layout_height="88dp"
                    android:layout_marginTop="6dp"
                    android:src="@drawable/s02_shoulder_icon"
                    android:scaleType="fitCenter"
                    android:contentDescription="어깨 운동 루틴 이미지" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="10dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="어깨 운동 루틴"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="#111111"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="운동 4개"
                        android:textSize="13sp"
                        android:textColor="#667085"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="1. 오버헤드프레스&#10;2. 사이드 레터럴 레이즈&#10;3. 프론트 레이즈&#10;4. 리어 델트 플라이"
                        android:textSize="12sp"
                        android:lineSpacingExtra="3dp"
                        android:textColor="#667085"/>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="10dp">

                    <ImageView
                        android:id="@+id/btnStartShoulder"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/s02_start_icon"
                        android:scaleType="fitCenter"
                        android:contentDescription="어깨 운동 시작"
                        android:clickable="true"
                        android:focusable="true" />

                    <ImageView
                        android:id="@+id/btnEditShoulder"
                        android:layout_width="30dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="3dp"
                        android:src="@drawable/s02_change_icon"
                        android:scaleType="fitCenter"
                        android:contentDescription="어깨 루틴 수정"
                        android:clickable="true"
                        android:focusable="true" />

                    <ImageView
                        android:id="@+id/btnDeleteShoulder"
                        android:layout_width="27dp"
                        android:layout_height="36dp"
                        android:padding="0dp"
                        android:src="@drawable/s02_delete"
                        android:scaleType="fitCenter"
                        android:contentDescription="어깨 루틴 삭제"
                        android:clickable="true"
                        android:focusable="true" />

                </LinearLayout>

            </LinearLayout>


            <!-- ====================================== -->
            <!-- 등록된 루틴이 없는 경우 -->
            <!-- ====================================== -->

            <LinearLayout
                android:id="@+id/layoutEmptyRoutine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="14dp"
                android:background="#F0F4F5">

                <TextView
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:gravity="center"
                    android:text="🏋"
                    android:textSize="25sp"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="10dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="등록된 운동 루틴이 없습니다."
                        android:textSize="13sp"
                        android:textColor="#667085"/>

                    <TextView
                        android:id="@+id/btnEmptyAddRoutine"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="지금 새로운 루틴을 만들어보세요!"
                        android:textSize="12sp"
                        android:textColor="#667085"/>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>


    <!-- ====================================== -->
    <!-- 하단 네비게이션 -->
    <!-- ====================================== -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#FFFFFF"
        android:elevation="8dp">

        <!-- 홈 -->

        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/fitlog_home"
                android:contentDescription="홈"
                android:scaleType="fitCenter"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="홈"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#168564"/>

        </LinearLayout>


        <!-- 루틴 -->

        <LinearLayout
            android:id="@+id/navRoutine"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/fitlog_routin"
                android:contentDescription="운동 루틴"
                android:scaleType="fitCenter"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="루틴"
                android:textSize="12sp"
                android:textColor="#888888"/>

        </LinearLayout>


        <!-- 운동 기록 -->

        <LinearLayout
            android:id="@+id/navRecord"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/fitlog_record"
                android:contentDescription="운동 기록"
                android:scaleType="fitCenter"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="운동 기록"
                android:textSize="11sp"
                android:textColor="#667085"/>

        </LinearLayout>


        <!-- 운동 일정 -->

        <LinearLayout
            android:id="@+id/navSchedule"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/fitlog_schedule"
                android:textColor="#667085"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="일정"
                android:textSize="12sp"
                android:textColor="#888888"/>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>