<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/fitlog_icon"
        android:label="@string/app_name"
        android:roundIcon="@drawable/fitlog_icon"
        android:supportsRtl="true"
        android:theme="@style/Theme.FigLogSample">

        <!-- S01 메인 화면 -->
        <activity
            android:name=".MainActivity"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- S02 운동 루틴 목록 -->
        <activity
            android:name=".S02RoutineListActivity"
            android:exported="false" />

        <!-- S03 운동 루틴 등록 및 수정 -->
        <activity
            android:name=".S03RoutineEditActivity"
            android:exported="false" />

        <!-- S04 운동 기록 -->
        <activity
            android:name=".WorkoutRecordActivity"
            android:exported="false" />

        <!-- S05 휴식시간 타이머 -->
        <activity
            android:name=".S05RestTimerActivity"
            android:exported="false" />

        <!--

        <activity
            android:name=".S06WorkoutHistoryActivity"
            android:exported="false" />

        <activity
            android:name=".S07WorkoutDetailActivity"
            android:exported="false" />

        <activity
            android:name=".S08WorkoutScheduleActivity"
            android:exported="false" />
        -->
    </application>

</manifest>